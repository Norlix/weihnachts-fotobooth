# Zugangsdaten für den Cloud-Speicher. Diese Datei als .env kopieren und die Werte eintragen.
# Die Datei .env wird nie committet. Den Schlüssel so anlegen, dass er nur auf den einen Bucket schreiben darf.
PHOTOBOOTH_S3_ACCESS_KEY=
PHOTOBOOTH_S3_SECRET_KEY=
# Nur nötig, wenn der Diashow-Bucket in einem anderen Konto liegt. Sonst leer lassen.
PHOTOBOOTH_S3_SLIDESHOW_ACCESS_KEY=
PHOTOBOOTH_S3_SLIDESHOW_SECRET_KEY=
