        'frame_left_percentage' => 6,
        'frame_right_percentage' => 6,
        'frame_top_percentage' => 7,
        'frame_bottom_percentage' => 14,
    ],
    // Qualität 90 statt 100 halbiert die Dateigröße bei 4K kaum sichtbar
    'jpeg_quality' => ['image' => 90],
    // Cloud-Speicher für QR-Download und Diashow. Zugangsschlüssel stehen nicht hier, sondern in der Datei .env
    'cloud' => [
        'enabled' => false,
        'provider_name' => 'Backblaze B2, Rechenzentrum Amsterdam',
        'endpoint' => 'https://s3.eu-central-003.backblazeb2.com',
        'region' => 'eu-central-003',
        'bucket' => 'BUCKET-FUER-FOTOS',
        // Zweiter Bucket für Diashow-Bilder und Manifest. Leer lassen, um denselben Bucket zu nutzen.
        'slideshow_bucket' => 'BUCKET-FUER-DIASHOW',
        // Leer lassen bei einem privaten Bucket. Dann sind alle Links signiert und laufen nach höchstens 7 Tagen ab.
        'public_base_url' => '',
        'retention_days' => 7,
    ],
    'qr' => ['custom_text' => true, 'text' => 'QR-Code scannen und das Foto auf dem Handy speichern.'],
