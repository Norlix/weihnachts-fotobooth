// Vorlage für config/my.config.inc.php. Die Datei in config/ ist per .gitignore ausgeschlossen und enthält die
// Einstellungen des jeweiligen Rechners. Hier stehen die Werte für den Weihnachts-Fotobooth-Betrieb.
return [
    'ui' => ['language' => 'de'],
    'christmasui' => ['enabled' => true, 'idle_minutes' => 5, 'protect_viewer' => true],
    'christmasar' => ['enabled' => true],
    // Galerie und Diashow sind nur über den passwortgeschützten Zugang unter /login erreichbar
    'gallery' => ['enabled' => false],
    'slideshow' => ['enabled' => false],
    'filters' => ['enabled' => false],
    'slideshowshare' => ['enabled' => true, 'timeout' => 30],
    // Der Standardtext "Photobooth we love OpenSource" auf der Collage entfällt
    'textoncollage' => ['enabled' => false],
    'collage' => ['first_cntdwn_time' => 5, 'cntdwn_time' => 3],
    // Zugang für Galerie und Diashow. Das Passwort wird im Admin-Bereich gesetzt und dort als Hash gespeichert.
    'login' => ['enabled' => true, 'username' => 'Photo', 'password' => null],
    'preview' => [
        'mode' => 'device_cam',
        'camTakesPic' => true,
        'asBackground' => true,
        'style' => 'contain',
        // Höchste Auflösung, die die Kamera liefert. Der Browser wählt das nächstliegende unterstützte Format.
        'videoWidth' => 3840,
        'videoHeight' => 2160,
